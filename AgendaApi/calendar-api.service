[Unit]
Description=Calendar API .NET Web Application
After=network.target

[Service]
Type=notify
WorkingDirectory=/var/www/calendar-api
ExecStart=/usr/bin/dotnet /var/www/calendar-api/AgendaApi.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=calendar-api
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:5001

[Install]
WantedBy=multi-user.target
