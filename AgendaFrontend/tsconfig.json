{
    "compilerOptions": {
      "target": "es2018",
      "module": "esnext",
      "moduleResolution": "node",
      "skipLibCheck": true,
      "lib": [
        "esnext",
        "esnext.asynciterable",
        "dom"
      ],
      "esModuleInterop": true,
      "allowJs": true,
      "sourceMap": true,
      "strict": true,
      "noEmit": true,
      "experimentalDecorators": true,
      "baseUrl": ".",
      "paths": {
        "@/*": [
          "./src/*"
        ],
        "~/*": [
          "./*"
        ]
      },
      "types": [
        "@types/node"
      ]
    },
    "include": ["components.d.ts"],
    "exclude": [
      "node_modules"
    ]
}